{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.test.{mjs,ts}"
      ],
      "project": ["scripts/**/*.{ts,mjs}"],
      "ignore": ["scripts/manual-auth-tests/**"]
    },
    "packages/cli": {
      "ignore": ["templates/**", "template-sources/**"]
    }
  },
  "ignore": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/dist/**",
    "**/node_modules/**",
    "**/templates/**",
    "**/template-sources/**",
    "**/*.config.{ts,js,cjs,mjs}"
  ],
  "ignoreBinaries": [
    "dot"
  ],
  "ignoreExportsUsedInFile": true
}
