{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2023"],
    "jsx": "preserve",
    "rootDir": "./src/core",
    "types": []
  },
  "include": ["src/core/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/core/**/*.test.ts",
    "src/core/**/*.spec.ts"
  ]
}
