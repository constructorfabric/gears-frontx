    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@gears-frontx/telemetry": "*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
