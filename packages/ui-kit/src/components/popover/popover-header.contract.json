    "partially_typed_props": {},
    "variant_sources": [],
    "cannot_extract": []
  },
  "props": {
    "title": "UiKit PopoverHeader",
    "type": "object",
    "properties": {},
    "required": [],
    "unevaluatedProperties": {
      "x-uikit-classification": "unchecked"
    }
  }
}
