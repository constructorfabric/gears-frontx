{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_group.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "sidebar-group",
  "forwards_to": "gts.frontx.uikit.element.dom_div.v1~",
  "intent": "One titled section of the sidebar panel.",
  "typical_uses": [
    "A section of related navigation rows under a small caption, optionally with a section action"
  ],
  "dont_use_when": [
    {
      "situation": "A section a user expands and collapses",
      "instead": {
        "target": "Collapsible",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.collapsible.v1",
        "note": "Place the group inside a Collapsible in SidebarContent; the group itself has no open state."
      }
    }
  ],
  "accepts": {
    "content": "specified",
    "components": [
      "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_group_label.v1",
      "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_group_action.v1",
      "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_group_content.v1"
    ]
  },
  "mounted_in": [
    {
      "container": "SidebarContent",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_content.v1"
    },
    {
      "container": "SidebarFooter",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_footer.v1"
    },
    {
      "container": "SidebarHeader",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.sidebar_header.v1"
    }
  ],
  "invariants": [
    {
      "id": "positions-its-action",
      "text": "SidebarGroup is a plain div with 8px padding and `position: relative`; a SidebarGroupAction inside it is positioned against the group's top-right corner, on the label's row."
    }
  ],
  "anti_patterns": [],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "A captioned section with an add action",
        "code": "<SidebarGroup>\n  <SidebarGroupLabel>Projects</SidebarGroupLabel>\n  <SidebarGroupAction aria-label=\"Add project\">\n    <PlusIcon />\n  </SidebarGroupAction>\n  <SidebarGroupContent>{menu}</SidebarGroupContent>\n</SidebarGroup>\n"
      }
    ],
    "bad": [
      {
        "title": "A menu straight in the group",
        "code": "<SidebarGroup>\n  <SidebarGroupLabel>Projects</SidebarGroupLabel>\n  <SidebarMenu>{items}</SidebarMenu>\n</SidebarGroup>\n",
        "why": "The group's body is SidebarGroupContent; the menu goes inside it."
      }
    ]
  },
  "family_membership": {
    "name": "sidebar",
    "role": "part"
  },
  "x-uikit": {
    "partially_typed_props": {},
    "variant_sources": [],
    "cannot_extract": []
  },
  "props": {
    "title": "UiKit SidebarGroup",
    "type": "object",
    "properties": {},
    "required": [],
    "unevaluatedProperties": {
      "x-uikit-classification": "unchecked"
    }
  }
}
