      }
    ],
    "bad": [
      {
        "title": "Rows without their menu",
        "code": "<SidebarGroupContent>\n  <SidebarMenuButton>Home</SidebarMenuButton>\n</SidebarGroupContent>\n",
        "why": "A row belongs in a SidebarMenuItem inside a SidebarMenu; alone it is not a list item and loses the menu's column layout."
