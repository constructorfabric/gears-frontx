{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.pagination_content.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "pagination-content",
  "forwards_to": "gts.frontx.uikit.element.dom_ul.v1~",
  "intent": "Hold the page items of a pagination as one row-shaped list.",
  "typical_uses": [
    "The one list inside a Pagination"
  ],
  "dont_use_when": [
    {
      "situation": "The list of crumbs inside a Breadcrumb",
      "instead": {
        "target": "BreadcrumbList",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.breadcrumb_list.v1"
      }
    }
  ],
  "accepts": {
    "content": "specified",
    "components": [
      "gts.frontx.uikit._.component.v1~frontx.uikit._.pagination_item.v1"
    ]
  },
  "mounted_in": [
    {
      "container": "Pagination",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.pagination.v1"
    }
  ],
  "invariants": [
    {
      "id": "single-row-that-does-not-wrap",
      "text": "The list is a flex row spaced var(--space-1) apart with no bullets, margin or padding and no wrapping (pagination.module.css `.content`), so a row wider than its container overflows it rather than breaking onto a second line."
    }
  ],
  "anti_patterns": [
    {
      "dont": "Render every page number of a long result set",
      "do_instead": "Show the pages around the current one and stand a PaginationEllipsis in for the rest"
    }
  ],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "verified",
      "by": "pagination.test.tsx asserts getByRole('list') resolves to a UL element"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "Two page items",
        "code": "<PaginationContent>\n  <PaginationItem>\n    <PaginationLink href=\"?page=1\">1</PaginationLink>\n  </PaginationItem>\n  <PaginationItem>\n    <PaginationLink href=\"?page=2\" isActive>2</PaginationLink>\n  </PaginationItem>\n</PaginationContent>\n"
      }
    ],
    "bad": [
      {
        "title": "Links without items",
        "code": "<PaginationContent>\n  <PaginationLink href=\"?page=1\">1</PaginationLink>\n</PaginationContent>\n",
        "why": "A `ul` may only hold `li` children; wrap each link in a PaginationItem."
      }
    ]
  },
  "family_membership": {
    "name": "pagination",
    "role": "part"
  },
  "x-uikit": {
    "partially_typed_props": {},
    "variant_sources": [],
    "cannot_extract": []
  },
  "props": {
    "title": "UiKit PaginationContent",
    "type": "object",
    "properties": {},
    "required": [],
    "unevaluatedProperties": {
      "x-uikit-classification": "unchecked"
    }
  }
}
