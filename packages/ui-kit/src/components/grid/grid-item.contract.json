{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.grid_item.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "grid-item",
  "forwards_to": "gts.frontx.uikit.element.dom_div.v1~",
  "intent": "Provide one block with a stable placement identity, size class, and height class within a Grid.",
  "typical_uses": [
    "A panel within a responsive Grid group"
  ],
  "dont_use_when": [
    {
      "situation": "The block is outside a Grid",
      "instead": {
        "target": "Native div"
      }
    }
  ],
  "accepts": {
    "content": "unconstrained"
  },
  "mounted_in": [
    {
      "container": "Grid",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.grid.v1"
    }
  ],
  "invariants": [
    {
      "id": "distinct-identities",
      "text": "layoutId identifies placement within the Grid; HTML id remains a separate attribute."
    }
  ],
  "anti_patterns": [
    {
      "dont": "Reuse a layoutId in the same Grid",
      "do_instead": "Give every item a distinct stable layoutId."
    }
  ],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "A low block",
        "code": "<GridItem layoutId=\"alerts\" size=\"small\">Alerts</GridItem>"
      }
    ],
    "bad": [
      {
        "title": "Missing placement identity",
        "code": "<GridItem size=\"small\">Alerts</GridItem>",
        "why": "Each item needs a layoutId for placement."
      }
    ]
  },
  "family_membership": {
    "name": "grid",
    "role": "part"
  },
  "x-uikit": {
    "partially_typed_props": {},
    "variant_sources": [],
    "cannot_extract": []
  },
  "props": {
    "title": "UiKit GridItem",
    "type": "object",
    "properties": {
      "height": {
        "type": "string",
        "enum": [
          "high",
          "low"
        ],
        "default": "low"
      },
      "layoutId": {
        "type": "string"
      },
      "size": {
        "type": "string",
        "enum": [
          "large",
          "medium",
          "small"
        ]
      }
    },
    "required": [
      "layoutId",
      "size"
    ],
    "unevaluatedProperties": {
      "x-uikit-classification": "unchecked"
    }
  }
}
