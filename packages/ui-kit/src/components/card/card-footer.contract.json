      {
        "title": "Two actions spaced on the footer",
        "code": "<CardFooter style={{ gap: 'var(--space-2)' }}>\n  <Button variant=\"outline\">Cancel</Button>\n  <Button>Upgrade</Button>\n</CardFooter>\n"
      }
    ],
    "bad": [
      {
        "title": "Two buttons with no gap between them",
        "code": "<CardFooter>\n  <Button variant=\"outline\">Cancel</Button>\n  <Button>Upgrade</Button>\n</CardFooter>\n",
        "why": "CardFooter adds no gap of its own, so the two buttons render flush against each other."
