        "code": "<DescriptionListItem>\n  <DescriptionListTerm>Owner</DescriptionListTerm>\n  <DescriptionListDetails>Platform team</DescriptionListDetails>\n</DescriptionListItem>\n"
      }
    ],
    "bad": [
      {
        "title": "Two terms in one item",
        "code": "<DescriptionListItem>\n  <DescriptionListTerm>Owner</DescriptionListTerm>\n  <DescriptionListTerm>Team</DescriptionListTerm>\n  <DescriptionListDetails>Platform</DescriptionListDetails>\n</DescriptionListItem>\n",
        "why": "A horizontal list has one term column per item row; the second term takes the value column. Give each pair its own item."
      }
