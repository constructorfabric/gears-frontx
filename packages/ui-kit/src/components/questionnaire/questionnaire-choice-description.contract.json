{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.questionnaire_choice_description.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "questionnaire-choice-description",
  "forwards_to": "gts.frontx.uikit.element.dom_span.v1~",
  "intent": "A second line under a QuestionnaireChoice's answer text that says what picking it means.",
  "typical_uses": [
    "A supporting sentence under one answer"
  ],
  "dont_use_when": [
    {
      "situation": "A hint that applies to the whole question",
      "instead": {
        "target": "QuestionnaireDescription",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.questionnaire_description.v1"
      }
    }
  ],
  "accepts": {
    "content": "specified",
    "text": true
  },
  "mounted_in": [
    {
      "container": "QuestionnaireChoice",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.questionnaire_choice.v1"
    },
    {
      "container": "QuestionnaireChoiceLabel",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.questionnaire_choice_label.v1"
    }
  ],
  "invariants": [
    {
      "id": "part-of-the-choice-name",
      "text": "It carries no id and is not wired into `aria-describedby`; inside a QuestionnaireChoice it sits in the row's label, so its text is part of the choice's accessible name."
    }
  ],
  "anti_patterns": [
    {
      "dont": "Place QuestionnaireChoiceDescription beside the choices instead of inside a QuestionnaireChoice",
      "do_instead": "Pass it among the QuestionnaireChoice's children, where it stacks under the answer text"
    }
  ],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "A second line under an answer",
        "code": "<QuestionnaireChoice value=\"pro\">\n  Pro\n  <QuestionnaireChoiceDescription>Everything included.</QuestionnaireChoiceDescription>\n</QuestionnaireChoice>\n"
      }
    ],
    "bad": [
      {
        "title": "The description outside its choice",
        "code": "<QuestionnaireChoices>\n  <QuestionnaireChoice value=\"pro\">Pro</QuestionnaireChoice>\n  <QuestionnaireChoiceDescription>Everything included.</QuestionnaireChoiceDescription>\n</QuestionnaireChoices>\n",
        "why": "Outside the row it becomes a separate grid cell that neither stacks under the answer nor belongs to its accessible name."
      }
    ]
  },
  "family_membership": {
    "name": "questionnaire",
    "role": "part"
  },
  "x-uikit": {
    "partially_typed_props": {},
    "variant_sources": [],
    "cannot_extract": []
  },
  "props": {
    "title": "UiKit QuestionnaireChoiceDescription",
    "type": "object",
    "properties": {},
    "required": [],
    "unevaluatedProperties": {
      "x-uikit-classification": "unchecked"
    }
  }
}
