  "invariants": [
    {
      "id": "muted-row-below-the-code",
      "text": "The footer is a flex row in --muted-foreground, inset var(--space-4) at the bottom and sides (var(--space-3) at sm); with a footer the content's own bottom inset drops to var(--space-2)."
    }
  ],
  "anti_patterns": [],
