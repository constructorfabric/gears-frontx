      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "A show more button",
        "code": "<CodeBlockFooter>\n  <Button variant=\"ghost\" size=\"sm\">Show more</Button>\n</CodeBlockFooter>\n"
      }
    ],
    "bad": [
      {
        "title": "The footer before the content",
        "code": "<CodeBlock>\n  <CodeBlockFooter>Show more</CodeBlockFooter>\n  <CodeBlockContent>npm install</CodeBlockContent>\n</CodeBlock>\n",
        "why": "The footer is the row below the code; above it, it reads before the code and the content keeps its full bottom inset."
      }
    ]
