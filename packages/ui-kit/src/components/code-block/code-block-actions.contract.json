{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block_actions.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "code-block-actions",
  "forwards_to": "gts.frontx.uikit.element.dom_div.v1~",
  "intent": "Group a code block's buttons, at the end of its header or floating over the code.",
  "typical_uses": [
    "A copy button, or a wrap toggle beside it"
  ],
  "dont_use_when": [
    {
      "situation": "The actions of a Card's header",
      "instead": {
        "target": "CardAction",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.card_action.v1"
      }
    }
  ],
  "accepts": {
    "content": "specified",
    "components": [
      "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block_copy_button.v1",
      "gts.frontx.uikit._.component.v1~frontx.uikit._.button.v1"
    ]
  },
  "mounted_in": [
    {
      "container": "CodeBlock",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block.v1"
    },
    {
      "container": "CodeBlockHeader",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block_header.v1"
    }
  ],
  "invariants": [
    {
      "id": "floats-without-a-header",
      "text": "Inside CodeBlockHeader the actions sit at the end of the row. As a direct child of CodeBlock they float at the top end, hidden until the block is hovered or holds focus and always shown on a coarse pointer, and their buttons take the --background fill."
    }
  ],
  "anti_patterns": [],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "Floating actions on a block without a header",
        "code": "<CodeBlock>\n  <CodeBlockActions>\n    <CodeBlockCopyButton value=\"npm install\" />\n  </CodeBlockActions>\n  <CodeBlockContent>npm install</CodeBlockContent>\n</CodeBlock>\n"
      }
    ],
    "bad": [
      {
        "title": "A copy button straight in the header",
        "code": "<CodeBlockHeader>\n  <CodeBlockTitle>Terminal</CodeBlockTitle>\n  <CodeBlockCopyButton value=\"npm install\" />\n</CodeBlockHeader>\n",
        "why": "The actions group is what pushes the buttons to the end of the row and tightens them to its edge; without it the button sits right after the title."
      }
    ]
  },
  "family_membership": {
    "name": "code_block",
    "role": "part"
  },
