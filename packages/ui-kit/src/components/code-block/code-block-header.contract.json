{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block_header.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "code-block-header",
  "forwards_to": "gts.frontx.uikit.element.dom_div.v1~",
  "intent": "Hold a code block's title and its actions in the row above the code.",
  "typical_uses": [
    "The row with the terminal or file name and a copy button"
  ],
  "dont_use_when": [
    {
      "situation": "The header block of a Card",
      "instead": {
        "target": "CardHeader",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.card_header.v1"
      }
    }
  ],
  "accepts": {
    "content": "specified",
    "components": [
      "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block_title.v1",
      "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block_actions.v1"
    ]
  },
  "mounted_in": [
    {
      "container": "CodeBlock",
      "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.code_block.v1"
    }
  ],
  "invariants": [
    {
      "id": "muted-row-above-the-code",
      "text": "The header is a flex row in --muted-foreground, inset var(--space-4) at the top and sides (var(--space-3) at sm); with a header the content's own top inset drops to var(--space-2)."
    }
  ],
  "anti_patterns": [],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "A title and its actions",
        "code": "<CodeBlockHeader>\n  <CodeBlockTitle>Terminal</CodeBlockTitle>\n  <CodeBlockActions>\n    <CodeBlockCopyButton value=\"npm install\" />\n  </CodeBlockActions>\n</CodeBlockHeader>\n"
      }
    ],
    "bad": [
      {
        "title": "The header after the content",
        "code": "<CodeBlock>\n  <CodeBlockContent>npm install</CodeBlockContent>\n  <CodeBlockHeader>\n    <CodeBlockTitle>Terminal</CodeBlockTitle>\n  </CodeBlockHeader>\n</CodeBlock>\n",
        "why": "The header is the row above the code; below it, the content keeps a header-side top inset and the title reads after the code."
      }
    ]
  },
