{
  "$id": "gts.frontx.uikit._.component.v1~frontx.uikit._.drawer_footer.v1",
  "gts_type": "gts.frontx.uikit._.component.v1~",
  "metamodel": "2.0.0",
  "component": "drawer-footer",
  "forwards_to": "gts.frontx.uikit.element.dom_div.v1~",
  "intent": "The action region at the bottom of a drawer's panel.",
  "typical_uses": [
    "The primary action stacked with a DrawerClose"
  ],
  "dont_use_when": [
    {
      "situation": "The action region of an edge panel with no swipe gesture",
      "instead": {
        "target": "SheetFooter",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.sheet_footer.v1"
      }
    },
    {
      "situation": "The action region of a centered dialog",
      "instead": {
        "target": "DialogFooter",
        "component": "gts.frontx.uikit._.component.v1~frontx.uikit._.dialog_footer.v1"
      }
    }
  ],
  "accepts": {
    "content": "unconstrained"
  },
  "invariants": [
    {
      "id": "stacked-column-at-every-width",
      "text": "DrawerFooter stacks its children in source order in a column spaced var(--space-2) apart at every viewport width, and does not shrink; its `margin-top: auto` pushes it to the bottom of the panel's content region when the panel is taller than its content."
    }
  ],
  "anti_patterns": [],
  "deprecations": {},
  "attestations": {
    "a11y": {
      "outcome": "unknown"
    },
    "rtl": {
      "outcome": "unknown"
    }
  },
  "examples": {
    "good": [
      {
        "title": "Save with a Cancel that closes the drawer",
        "code": "<DrawerFooter>\n  <Button onClick={save}>Save</Button>\n  <DrawerClose render={<Button variant=\"outline\" />}>Cancel</DrawerClose>\n</DrawerFooter>\n"
      }
    ],
    "bad": [
      {
        "title": "A footer placed outside the panel",
        "code": "<Drawer>\n  <DrawerTrigger>Edit</DrawerTrigger>\n  <DrawerFooter>\n    <Button onClick={save}>Save</Button>\n  </DrawerFooter>\n  <DrawerContent>\n    <DrawerTitle>Edit</DrawerTitle>\n  </DrawerContent>\n</Drawer>\n",
        "why": "Only DrawerContent is portalled into the panel; a footer beside it renders in the page, visible whether the drawer is open or not."
      }
    ]
  },
  "family_membership": {
    "name": "drawer",
    "role": "part"
  },
  "x-uikit": {
    "partially_typed_props": {},
    "variant_sources": [],
    "cannot_extract": []
  },
  "props": {
    "title": "UiKit DrawerFooter",
    "type": "object",
    "properties": {},
    "required": [],
    "unevaluatedProperties": {
      "x-uikit-classification": "unchecked"
    }
  }
}
