{
  "$id": "gts://gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    { "$ref": "gts://gts.frontx.mfes.mfe.entry.v1~" }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "manifest": {
      "type": "string",
      "x-gts-instance-ref": "gts.frontx.mfes.mfe.mf_manifest.v1~*"
    },
    "exposedModule": {
      "type": "string",
      "minLength": 1
    },
    "exposeAssets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "js": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sync": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          },
          "required": ["sync"]
        },
        "css": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sync": { "type": "array", "items": { "type": "string" } },
            "async": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["sync", "async"]
        }
      },
      "required": ["js", "css"]
    }
  },
  "required": ["manifest", "exposedModule", "exposeAssets"]
}
