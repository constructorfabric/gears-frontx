{
  "$id": "gts://gts.frontx.mfes.comm.action.v1~",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "x-gts-type-ref": "/$id",
      "$comment": "Self-reference to this action's type ID"
    },
    "target": {
      "anyOf": [
        { "x-gts-instance-ref": "gts.frontx.mfes.ext.domain.v1~*" },
        { "x-gts-instance-ref": "gts.frontx.mfes.ext.extension.v1~*" }
      ],
      "$comment": "Instance ID of the target ExtensionDomain or Extension. anyOf, not oneOf: the two sets cannot overlap, and the GTS library compares only an anyOf when it checks that a derived action narrows this field"
    },
    "payload": {
      "type": "object",
      "$comment": "Optional action payload"
    },
    "timeout": {
      "type": "number",
      "minimum": 1,
      "$comment": "Optional timeout override in milliseconds"
    }
  },
  "required": ["type", "target"]
}
