{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Nothing is emitted here; the base config's declaration/outDir settings
    // describe the library build, and without this a check-only run writes
    // build output into dist/.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "__tests__/**/*"],
  // `exclude` filters `include`, so the base config's `**/__tests__/**` and
  // `**/*.test.ts` entries are inherited and cancel the `__tests__` include
  // above — this config type-checked no test at all. Restated here without
  // them, which is the whole point of a test config.
  "exclude": ["node_modules", "dist"]
}
