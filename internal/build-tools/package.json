{
  "name": "@gears-frontx/build-tools",
  "version": "0.1.0-alpha.0",
  "description": "Shared tsup/esbuild build plugins for the ecosystem packages' module-preserving ESM output.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "tsup": "8.5.1",
    "vitest": "4.1.4"
  },
  "keywords": [
    "build-tools",
    "frontx"
  ]
}
