{
  "description": "Worked GTS ID examples drawn from template-mfe's own MFE packages (demo-mfe, _blank-mfe, widgets-fixture-a/b), for direct citation/reuse when authoring a new MFE package's mfe.json. Companion to the gts-id-conventions guideline in this same bundle.",
  "namespaceRoot": "frontx",
  "families": [
    {
      "family": "mf_manifest",
      "pattern": "gts.frontx.mfes.mfe.mf_manifest.v1~{app}.mfe.{package}.manifest.v1",
      "examples": [
        "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.demo.mfe.manifest.v1",
        "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.blank.mfe.manifest.v1",
        "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.widgets.fixture_a.manifest.v1"
      ]
    },
    {
      "family": "mfe_entry",
      "pattern": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~{app}.mfe.{package}.{screen}.v1",
      "examples": [
        "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.demo.mfe.profile.v1",
        "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.demo.mfe.helloworld.v1",
        "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.blank.mfe.home.v1",
        "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.widgets.fixture_a.entry.v1"
      ]
    },
    {
      "family": "screen_extension",
      "pattern": "gts.frontx.mfes.ext.extension.v1~frontx.screensets.layout.screen.v1~{app}.screens.{screen}.v1",
      "domain": "gts.frontx.mfes.ext.domain.v1~frontx.screensets.layout.screen.v1",
      "examples": [
        "gts.frontx.mfes.ext.extension.v1~frontx.screensets.layout.screen.v1~frontx.demo.screens.profile.v1",
        "gts.frontx.mfes.ext.extension.v1~frontx.screensets.layout.screen.v1~frontx.demo.screens.helloworld.v1",
        "gts.frontx.mfes.ext.extension.v1~frontx.screensets.layout.screen.v1~frontx.blank.screens.home.v1"
      ]
    },
    {
      "family": "widget_area_extension",
      "pattern": "gts.frontx.mfes.ext.extension.v1~{app}.{fixture}.{widget}.v1",
      "domain": "gts.frontx.mfes.ext.domain.v1~frontx.widgets.area.{area}.v1",
      "examples": [
        "gts.frontx.mfes.ext.extension.v1~frontx.widgets.fixture_a.widget_alpha.v1",
        "gts.frontx.mfes.ext.extension.v1~frontx.widgets.fixture_a.widget_beta.v1"
      ]
    },
    {
      "family": "custom_action",
      "pattern": "gts.frontx.mfes.comm.action.v1~{app}.action.{name}.v1~",
      "examples": [
        "gts.frontx.mfes.comm.action.v1~frontx.demo.action.refresh_profile.v1~",
        "gts.frontx.mfes.comm.action.v1~frontx.widgets.test.widget_ping.v1~"
      ]
    },
    {
      "family": "fixed_shared_properties",
      "note": "Never redefined; referenced verbatim by every screen entry's requiredProperties.",
      "examples": [
        "gts.frontx.mfes.comm.shared_property.v1~frontx.mfes.comm.theme.v1~",
        "gts.frontx.mfes.comm.shared_property.v1~frontx.mfes.comm.language.v1~"
      ]
    },
    {
      "family": "fixed_lifecycle_actions",
      "note": "Never redefined; referenced verbatim by domain declarations and entry actions/domainActions.",
      "examples": [
        "gts.frontx.mfes.comm.action.v1~frontx.mfes.ext.load_ext.v1~",
        "gts.frontx.mfes.comm.action.v1~frontx.mfes.ext.mount_ext.v1~",
        "gts.frontx.mfes.comm.action.v1~frontx.mfes.ext.unmount_ext.v1~"
      ]
    }
  ]
}
