{
  "name": "@gears-frontx/demo-mfe",
  "private": true,
  "version": "0.2.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently \"vite build --watch\" \"vite preview --port 3001\"",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview --port 3001",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch"
  },
  "dependencies": {
    "@gears-frontx/react": "0.2.0-alpha.0",
    "@gears-frontx/ui-kit": "0.3.0-alpha.1",
    "@tanstack/react-query": "5.90.21",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@module-federation/vite": "^1.14.2",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "4.3.4",
    "@gears-frontx/frontx-template-shell": "0.1.0-alpha.2",
    "jsdom": "26.1.0",
    "typescript": "5.4.2",
    "vite": "6.4.3",
    "vitest": "4.1.4"
  }
}
